import assert from "node:assert/strict";import {mkdtemp,realpath,rm,writeFile} from "node:fs/promises";import {tmpdir} from "node:os";import path from "node:path";import {randomBytes,randomUUID} from "node:crypto";import {execFileSync} from "node:child_process";import {PrismaClient} from "@prisma/client";import {initializeReferenceData} from "../src/lib/bootstrap";import {ROLE_PERMISSIONS,ROLE_ACCESS,type RoleKey} from "../src/lib/permissions";import type {SessionUser} from "../src/lib/session";import {chatHome,chatUnread,openChat,readChat,sendChat,markChatRead} from "../src/lib/internal-chat";import {createServiceCase} from "../src/lib/service-cases";
const parent=await realpath(tmpdir()),dir=await mkdtemp(path.join(parent,"crm-staff-chat-")),url="file:"+path.join(dir,"test.db").replaceAll("\\","/");process.env.CRM_DATA_ENCRYPTION_KEY=randomBytes(32).toString("hex");const db=new PrismaClient({datasources:{db:{url}}});
try{await writeFile(path.join(dir,"test.db"),"");execFileSync(process.execPath,["node_modules/prisma/build/index.js","migrate","deploy"],{env:{...process.env,DATABASE_URL:url},stdio:"pipe"});await db.$transaction(initializeReferenceData);const b=await db.branch.create({data:{code:"CHAT",name:"Chat fixture",city:"Test"}}),outside=await db.branch.create({data:{code:"OUT",name:"Outside",city:"Test"}});
 async function actor(id:string,role:RoleKey,branchId=b.id):Promise<SessionUser>{const r=await db.role.findUniqueOrThrow({where:{key:role}});await db.user.create({data:{id,employeeCode:id,name:id,email:id+"@example.test",phone:"",passwordHash:"synthetic",roleId:r.id,branchId}});return{id,name:id,email:id+"@example.test",role,roleName:r.name,branchId,branchName:"Test",employeeCode:id,permissions:ROLE_PERMISSIONS[role],accessMode:ROLE_ACCESS[role],sessionId:"session-"+id};}
 const owner=await actor("owner","OWNER"),staff=await actor("staff","TRAVEL_EXECUTIVE"),peer=await actor("peer","TICKETING_EXECUTIVE"),remote=await actor("remote","TICKETING_EXECUTIVE",outside.id),reader=await actor("reader","READ_ONLY");const home=await chatHome(db,staff);assert(home.contacts.some(p=>p.id===owner.id));assert(!home.contacts.some(p=>p.id===remote.id));await assert.rejects(()=>openChat(db,staff,{kind:"DIRECT",peerId:remote.id}),/active colleague/);await assert.rejects(()=>chatHome(db,reader),/not available/);
 const t=await openChat(db,staff,{kind:"DIRECT",peerId:owner.id});assert.equal((await openChat(db,owner,{kind:"DIRECT",peerId:staff.id})).threadId,t.threadId);assert.equal(await db.staffChatThread.count(),1);await assert.rejects(()=>readChat(db,peer,t.threadId),/outside your access/);
 const body={requestKey:randomUUID(),body:"SYNTHETIC-PRIVATE-STAFF-CONTENT"};const first=await sendChat(db,staff,t.threadId,body);assert.equal((await sendChat(db,staff,t.threadId,body)).replayed,true);assert.equal(await db.staffChatMessage.count(),1);assert.equal(await chatUnread(db,owner),1);await assert.rejects(()=>sendChat(db,staff,t.threadId,{...body,body:"Changed"}),/different text/);
 const saved=await db.staffChatMessage.findUniqueOrThrow({where:{id:first.messageId}});assert(saved.body.startsWith("v1."));assert(!saved.body.includes("PRIVATE-STAFF"));assert.equal((await readChat(db,owner,t.threadId)).messages[0].body,body.body);await markChatRead(db,owner,t.threadId,first.messageId);assert.equal(await chatUnread(db,owner),0);
 const second=await sendChat(db,staff,t.threadId,{requestKey:randomUUID(),body:"Next message"});await markChatRead(db,owner,t.threadId,first.messageId);assert.equal(await chatUnread(db,owner),1);await markChatRead(db,owner,t.threadId,second.messageId);assert.equal(await chatUnread(db,owner),0);assert.deepEqual((await readChat(db,owner,t.threadId)).messages.map(m=>m.sequence),[1,2]);
 const customer=await db.customer.create({data:{code:"C-CHAT",name:"Case fixture",phone:"",city:"",branchId:b.id,assignedToId:staff.id}});const c=await db.$transaction(tx=>createServiceCase(tx,{customerId:customer.id,branchId:b.id,ownerId:staff.id,service:"FLIGHT",title:"Synthetic case chat"},owner.id));const room=await openChat(db,staff,{kind:"CASE",caseId:c.id});await sendChat(db,staff,room.threadId,{requestKey:randomUUID(),body:"Case-specific discussion"});await assert.rejects(()=>readChat(db,peer,room.threadId),/outside your access/);const caseMessage=await db.staffChatMessage.findFirstOrThrow({where:{threadId:room.threadId}});await assert.rejects(()=>markChatRead(db,owner,t.threadId,caseMessage.id),/Choose a message/);
 const task=await db.task.create({data:{title:"Scoped case task",ownerId:peer.id,customerId:customer.id,branchId:b.id,serviceCaseId:c.id}});assert.equal((await openChat(db,peer,{kind:"CASE",caseId:c.id})).threadId,room.threadId);assert.equal((await readChat(db,peer,room.threadId)).messages.length,1);await db.task.update({where:{id:task.id},data:{ownerId:staff.id}});await assert.rejects(()=>readChat(db,peer,room.threadId),/outside your access/);
 await db.user.update({where:{id:owner.id},data:{active:false}});assert.equal((await readChat(db,staff,t.threadId)).canReply,false);await assert.rejects(()=>sendChat(db,staff,t.threadId,{requestKey:randomUUID(),body:"No inactive recipient"}),/inactive/);assert(!JSON.stringify(await db.auditLog.findMany()).includes(body.body));const key=process.env.CRM_DATA_ENCRYPTION_KEY;delete process.env.CRM_DATA_ENCRYPTION_KEY;await assert.rejects(()=>sendChat(db,staff,t.threadId,{requestKey:randomUUID(),body:"No key"}),/encryption key/);process.env.CRM_DATA_ENCRYPTION_KEY=key;
 console.log("PASS internal chat: encrypted real-database messages, direct/case scope, branch directory, replay/conflict, monotonic order/read markers, unread counters, revoked case access, inactive users and private audit.");
}finally{await db.$disconnect();const actual=await realpath(dir);assert.equal(path.dirname(actual),parent);assert(path.basename(actual).startsWith("crm-staff-chat-"));await rm(actual,{recursive:true,force:true});}
