import assert from "node:assert/strict";
import { mkdtempSync, cpSync, readdirSync, mkdirSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { PrismaClient } from "@prisma/client";
import { emptyPackage, validatePackage, safePackageImage, publicPackage } from "../src/lib/travel-packages";
import type { SessionUser } from "../src/lib/session";

const dir = mkdtempSync(path.join(tmpdir(), "crm-packages-"));
const url = `file:${path.join(dir, "fixture.db")}`;
process.env.DATABASE_URL = url;
function migrate(schema: string) {
  const p = spawnSync(process.execPath, ["node_modules/prisma/build/index.js", "migrate", "deploy", "--schema", schema], { env: { ...process.env, DATABASE_URL: url }, encoding: "utf8" });
  assert.equal(p.status, 0, p.stderr + p.stdout);
}
const base = path.join(dir, "baseline"); mkdirSync(path.join(base, "migrations"), { recursive: true });
cpSync("prisma/schema.prisma", path.join(base, "schema.prisma"));
for (const entry of readdirSync("prisma/migrations")) if (entry !== "20261021220000_travel_packages") cpSync(path.join("prisma/migrations", entry), path.join(base, "migrations", entry), { recursive: true });
migrate(path.join(base, "schema.prisma"));
const db = new PrismaClient({ datasources: { db: { url } } });
const { savePackage, publishedPackage, assertPackageManager } = await import("../src/lib/travel-package-service");
const { prisma } = await import("../src/lib/db");
try {
  await db.settings.create({ data: { key: "package-migration-preservation", value: "Keep existing agency settings" } });
  migrate(path.resolve("prisma/schema.prisma"));
  assert.equal((await db.settings.findUniqueOrThrow({ where: { key: "package-migration-preservation" } })).value, "Keep existing agency settings");
  const role = await db.role.create({ data: { key: "OWNER", name: "Owner", desc: "Isolated fixture" } });
  const actor = await db.user.create({ data: { employeeCode: "PKG-TEST", name: "Fixture owner", email: "packages@example.test", phone: "", passwordHash: "non-login-fixture", roleId: role.id } });
  const owner: SessionUser = { id: actor.id, name: actor.name, email: actor.email, role: "OWNER", roleName: "Owner", branchId: null, branchName: null, employeeCode: actor.employeeCode, accessMode: "ALL", permissions: ["settings:manage"] };
  for (const restricted of [{ ...owner, accessMode: "BRANCH" as const, branchId: "another-branch" }, { ...owner, accessMode: "ASSIGNED" as const }, { ...owner, permissions: [] }]) assert.throws(() => assertPackageManager(restricted), /agency-wide/);
  const draft = { ...structuredClone(emptyPackage), title: "Kerala slow travel", destination: "Kerala", summary: "A carefully planned escape", description: "Backwaters and local cuisine.", itinerary: [{ day: 1, title: "Arrival", description: "Meet the team and explore." }], inclusions: ["Local transfer"], exclusions: ["Flights"], terms: "Confirm the final quote before payment.", cancellationPolicy: "Supplier-specific charges will be quoted.", availabilityNotes: "All dates subject to confirmation.", contactEmail: "travel@example.test", internalNotes: "PRIVATE SUPPLIER MARGIN 99" };
  assert.deepEqual(validatePackage(draft, true).errors, []);
  const unfinished = { ...draft, itinerary: [{ day: 1, title: "", description: "" }], gallery: [{ url: "", alt: "" }] };
  assert.deepEqual(validatePackage(unfinished).errors, []); assert(validatePackage(unfinished, true).errors.length);
  assert(validatePackage({ ...draft, itinerary: [] }, true).errors.length);
  assert(validatePackage({ ...draft, priceBasis: "PER_PERSON", priceAmount: 123.456 }, true).errors.length);
  assert(validatePackage({ ...draft, priceBasis: "PER_PERSON", priceAmount: 15000, priceValidUntil: "2000-01-01" }, true).errors.length);
  assert(validatePackage({ ...draft, contactEmail: "", contactPhone: "1234" }, true).errors.length);
  assert(validatePackage({ ...draft, travelStart: "2026-02-30" }).errors.length);
  assert(validatePackage({ ...draft, durationDays: 2, itinerary: [{ day: 1, title: "A", description: "A" }, { day: 1, title: "B", description: "B" }] }).errors.length);
  for (const bad of ["https://images.unsplash.com/photo-1#", "https://pix8.agoda.net/hotelImages/photo.jpg?", "https://i.travelapi.com/lodging/photo.jpg#", "http://images.unsplash.com/photo-1", "https://evil.example/pic.jpg", "https://images.unsplash.com:443/photo-1", "https://images.unsplash.com/photo-1#fragment", "https://images.unsplash.com/photo-1?w=1&w=2", "https://images.unsplash.com/photo-1?url=https://evil.test", "https://images.unsplash.com/photo-1?w=4001", "https://pix8.agoda.net/hotelImages/%2e%2e/test", "https://pix8.agoda.net/hotelImages/../secret", "https://i.travelapi.com/lodging/x?token=secret", "https://images.unsplash.com\\@evil.test/photo-1"]) assert.equal(safePackageImage(bad), false, bad);
  for (const good of ["", "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1200&q=80", "https://pix8.agoda.net/hotelImages/1/image.jpg", "https://i.travelapi.com/lodging/1/image.jpg"]) assert.equal(safePackageImage(good), true, good);
  const expired = publicPackage({ ...draft, priceBasis: "PER_PERSON", priceAmount: 15000, priceValidUntil: "2000-01-01", travelEnd: "2000-01-02" }, { id: "fixture", slug: "fixture", publishedAt: new Date() });
  assert.equal(expired.priceAmount, null); assert.equal(expired.priceBasis, "ON_REQUEST"); assert.equal(expired.availability, "UNAVAILABLE"); assert(!JSON.stringify(expired).includes("PRIVATE"));
  let saved = await savePackage(db, owner, { slug: "kerala-slow-travel", draft });
  assert.equal(saved.status, "DRAFT");
  assert.equal(publishedPackage(await db.travelPackage.findUniqueOrThrow({ where: { id: saved.id } })), null);
  await assert.rejects(savePackage(db, owner, { action: "PUBLISH", slug: saved.slug, draft, revision: 99 }, saved.id), /another window/);
  saved = await savePackage(db, owner, { action: "PUBLISH", slug: saved.slug, draft, revision: saved.revision }, saved.id);
  let publicRow = publishedPackage(await db.travelPackage.findUniqueOrThrow({ where: { id: saved.id } }));
  assert(publicRow); assert(!JSON.stringify(publicRow).includes("PRIVATE")); assert(!("revision" in publicRow));
  const publishedTitle = publicRow.title;
  saved = await savePackage(db, owner, { slug: saved.slug, draft: { ...draft, title: "Changed draft only" }, revision: saved.revision }, saved.id);
  assert(saved.hasUnpublishedChanges);
  assert.equal(publishedPackage(await db.travelPackage.findUniqueOrThrow({ where: { id: saved.id } }))?.title, publishedTitle);
  await assert.rejects(savePackage(db, owner, { slug: "new-url-not-allowed", draft, revision: saved.revision }, saved.id), /locked/);
  await assert.rejects(savePackage(db, owner, { slug: saved.slug, draft }), /already in use/);
  const list = await import("../src/app/api/public/travel-packages/route");
  const detail = await import("../src/app/api/public/travel-packages/[slug]/route");
  const get = (slug: string) => detail.GET(new Request(`http://localhost/api/public/travel-packages/${slug}`), { params: Promise.resolve({ slug }) });
  assert.equal((await get(saved.slug)).status, 200);
  assert.equal((await get("unknown-package")).status, 404);
  let payload = await (await list.GET()).json(); assert.equal(payload.packages.length, 1); assert.equal(payload.truncated, false); assert(!JSON.stringify(payload).includes("PRIVATE"));
  saved = await savePackage(db, owner, { action: "UNPUBLISH", revision: saved.revision }, saved.id);
  assert.equal((await get(saved.slug)).status, 404); assert.equal((await (await list.GET()).json()).packages.length, 0);
  saved = await savePackage(db, owner, { action: "ARCHIVE", revision: saved.revision }, saved.id);
  await assert.rejects(savePackage(db, owner, { slug: saved.slug, draft, revision: saved.revision }, saved.id), /Restore/);
  saved = await savePackage(db, owner, { action: "RESTORE", revision: saved.revision }, saved.id);
  assert.equal(saved.status, "DRAFT"); assert.equal((await get(saved.slug)).status, 404);
  saved = await savePackage(db, owner, { action: "PUBLISH", slug: saved.slug, draft, revision: saved.revision }, saved.id);
  await db.travelPackage.create({ data: { slug: "malformed-old-package", title: "Invalid fixture", draftJson: "{}", publishedJson: "{}", status: "PUBLISHED", publishedAt: new Date() } });
  payload = await (await list.GET()).json(); assert.equal(payload.packages.length, 1); assert.equal(payload.unavailableCount, 1);
  assert.equal(await db.auditLog.count({ where: { entity: "TravelPackage", entityId: saved.id } }), 7);
  console.log("Travel packages: migration preservation, roles, validation, safe media, expiry, publication snapshots, optimistic conflicts, public API privacy/404, archive/restore and audit passed.");
} finally { await db.$disconnect(); await prisma.$disconnect(); rmSync(dir, { recursive: true, force: true }); }
