import assert from 'node:assert/strict';
import test from 'node:test';
import {deploymentProtectionHeaders} from '../src/lib/deployment-protection';
const target='https://preview-target.vercel.app',headers={Authorization:'synthetic-app-signature'};
test('only an explicitly allowed HTTPS origin receives the deployment identity, with application authentication preserved',async()=>{let calls=0;const env={VERCEL:'1',PROTECTED_API_ORIGINS:JSON.stringify([target])};const h=await deploymentProtectionHeaders(target+'/api',headers,env,async()=>{calls++;return 'synthetic-identity';});assert.equal(calls,1);assert.equal(h.Authorization,headers.Authorization);assert.equal(h['x-vercel-trusted-oidc-idp-token'],'synthetic-identity');assert.equal(Object.keys(headers).length,1);});
test('deployment identity is never requested for another origin, HTTP or a non-Vercel worker',async()=>{const read=async()=>{throw Error('Identity must not be requested');};const env={VERCEL:'1',PROTECTED_API_ORIGINS:JSON.stringify([target])};for(const url of['https://other.example.test/api','http://preview-target.vercel.app/api'])assert.deepEqual(await deploymentProtectionHeaders(url,headers,env,read),headers);assert.deepEqual(await deploymentProtectionHeaders(target,headers,{},read),headers);});
test('malformed, non-origin and insecure allowlists fail closed without disclosing identity',async()=>{for(const value of['invalid','{}',JSON.stringify(['http://target.example.test']),JSON.stringify([target+'/path']),JSON.stringify([123])])await assert.rejects(deploymentProtectionHeaders(target,headers,{VERCEL:'1',PROTECTED_API_ORIGINS:value},async()=>{throw Error('Identity must not be requested');}),/Protected API origins/);});
test('missing runtime identity fails closed for an allowlisted target',async()=>{await assert.rejects(deploymentProtectionHeaders(target,headers,{VERCEL:'1',PROTECTED_API_ORIGINS:JSON.stringify([target])},async()=>''),/identity is unavailable/);});
