import assert from 'node:assert/strict';
import {mkdtemp,mkdir,cp,readdir,writeFile,rm,realpath} from 'node:fs/promises';
import {tmpdir} from 'node:os';import path from 'node:path';import {execFileSync} from 'node:child_process';import {PrismaClient} from '@prisma/client';
const parent=await realpath(tmpdir()),dir=await mkdtemp(path.join(parent,'crm-payable-upgrade-')),schema=path.join(dir,'prisma/schema.prisma'),url='file:'+path.join(dir,'upgrade.db').replaceAll('\\','/'),name='20261103060000_visa_supplier_payables';const db=new PrismaClient({datasources:{db:{url}}}),env={...process.env,DATABASE_URL:url},cli=path.resolve('node_modules/prisma/build/index.js');
try{await mkdir(path.join(dir,'prisma/migrations'),{recursive:true});await cp('prisma/schema.prisma',schema);await writeFile(path.join(dir,'upgrade.db'),'');for(const file of await readdir('prisma/migrations'))if(file!==name)await cp(path.join('prisma/migrations',file),path.join(dir,'prisma/migrations',file),{recursive:true});execFileSync(process.execPath,[cli,'migrate','deploy','--schema',schema],{env,stdio:'pipe'});
 await db.supplier.create({data:{id:'legacy-vendor',name:'Synthetic legacy vendor'}});await db.$executeRaw`INSERT INTO "SupplierDue" (id,supplierId,description,supplierInvoiceNo,amount,paidAmount,dueDate,paid) VALUES ('legacy-due','legacy-vendor','Original invoice','LEGACY-001',1000,300,${new Date('2026-10-31')},false)`;await db.supplierSettlement.create({data:{id:'legacy-settlement',dueId:'legacy-due',amount:300,method:'NEFT',requestKey:'synthetic-legacy-payment'}});const before=await db.$queryRawUnsafe('SELECT id,supplierId,description,supplierInvoiceNo,amount,paidAmount,dueDate,paid FROM "SupplierDue"');await db.$disconnect();await cp(path.join('prisma/migrations',name),path.join(dir,'prisma/migrations',name),{recursive:true});execFileSync(process.execPath,[cli,'migrate','deploy','--schema',schema],{env,stdio:'pipe'});
 assert.deepEqual(await db.$queryRawUnsafe('SELECT id,supplierId,description,supplierInvoiceNo,amount,paidAmount,dueDate,paid FROM "SupplierDue"'),before);assert.equal((await db.supplierDue.findUniqueOrThrow({where:{id:'legacy-due'}})).visaCaseId,null);assert.equal((await db.supplierSettlement.findUniqueOrThrow({where:{id:'legacy-settlement'}})).amount,300);assert.deepEqual(await db.$queryRawUnsafe('PRAGMA foreign_key_check'),[]);const columns=await db.$queryRawUnsafe('PRAGMA table_info("SupplierDue")');assert(columns.some(c=>c.name==='visaCaseId'));console.log('PASS payable migration: original invoice, partial paid balance and settlement history survive the real table upgrade with all foreign keys valid.');
}finally{await db.$disconnect();const actual=await realpath(dir);assert.equal(path.dirname(actual),parent);assert(path.basename(actual).startsWith('crm-payable-upgrade-'));await rm(actual,{recursive:true,force:true});}
