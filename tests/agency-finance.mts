import assert from "node:assert/strict";import {bookingAccount,rescheduleQuote,deliveryBalance} from "../src/lib/agency-finance";import {passportReadiness} from "../src/lib/travel-readiness";
const base={status:"TICKETED",sellingPrice:5000,supplierCost:4000,costConfirmed:true,currency:"INR",payments:[],refunds:[]};let a=bookingAccount(base);assert.equal(a.marginMinor,100000);assert.equal(deliveryBalance([a],null).allowed,false);
a=bookingAccount({...base,payments:[{amount:2000}]});assert.equal(a.balanceMinor,300000);assert.equal(deliveryBalance([a],null).allowed,false);assert.equal(deliveryBalance([a],{active:true,reason:"Approved corporate credit exception"}).allowed,true);assert.equal(deliveryBalance([a],{active:true,reason:""}).allowed,false);
a=bookingAccount({...base,payments:[{amount:5000}]});assert.equal(deliveryBalance([a],null).allowed,true);assert.equal(bookingAccount({...base,costConfirmed:false}).marginMinor,null);assert.equal(bookingAccount({...base,supplierCost:5200}).marginMinor,-20000);
const change=rescheduleQuote({fareDifference:800,taxDifference:0,airlineFee:400,noShowFee:0,agencyFee:200});assert.equal(change.additionalChargeMinor,140000);assert.equal(change.supplierCostMinor,120000);assert.equal(a.marginMinor!+change.marginMinor,120000);assert.throws(()=>rescheduleQuote({fareDifference:-1,taxDifference:0,airlineFee:0,noShowFee:0,agencyFee:0}));
assert.equal(deliveryBalance([bookingAccount({...base,payments:[{amount:5000}],refunds:[{amount:500,status:"REQUESTED"}]})],null).allowed,false);assert.equal(deliveryBalance([bookingAccount({...base,payments:[{amount:5000}],refunds:[{amount:500,status:"PAID"}]})],null).allowed,false);
assert.equal(bookingAccount({...base,status:"CANCELLED",cancellationSupplierCharge:500,cancellationAgencyFee:200}).marginMinor,20000);assert.equal(bookingAccount({...base,status:"CANCELLED"}).marginMinor,null);assert.equal(deliveryBalance([bookingAccount({...base,currency:"USD",payments:[{amount:5000}]})],null).allowed,false);
const person={fullName:"Synthetic traveller"};assert.deepEqual(passportReadiness([person],"DOMESTIC","FLIGHT",null,"2026-11-03"),[]);assert.equal(passportReadiness([person],"INTERNATIONAL","FLIGHT",null,"2026-11-03").length,2);assert.equal(passportReadiness([person],"DOMESTIC","VISA",null,"2026-11-03").length,2);assert.deepEqual(passportReadiness([{...person,passportNumber:"FIXTURE",passportExpiry:"2030-01-01"}],"INTERNATIONAL","FLIGHT","2027-02-01","2026-11-03"),[]);assert.equal(passportReadiness([{...person,passportNumber:"FIXTURE",passportExpiry:"2026-11-02"}],"INTERNATIONAL","FLIGHT","2027-01-01","2026-11-03").length,1);
console.log("PASS agency domain scenarios: credit/partial/full settlement, explicit exception, refund hold, reissue incremental profit, loss, unknown cost, currency separation and domestic/international passport readiness.");

assert.equal(deliveryBalance([],null).allowed,false);assert.equal(deliveryBalance([bookingAccount({...base,status:"CANCELLED"})],{active:true,reason:"Cannot revive a void ticket"}).allowed,false);

assert.equal(deliveryBalance([bookingAccount({...base,status:"ENQUIRY",sellingPrice:0})],null).allowed,false);

assert.equal(passportReadiness([],"INTERNATIONAL","FLIGHT",null,"2026-11-03").length,1);assert.equal(passportReadiness([person],"UNSPECIFIED","FLIGHT",null,"2026-11-03").length,1);

assert.equal(deliveryBalance([bookingAccount({...base,sellingPrice:0,payments:[]})],null).allowed,false);assert.equal(deliveryBalance([bookingAccount({...base,sellingPrice:0,payments:[]})],{active:true,reason:"Complimentary service approved by administrator"}).allowed,true);
