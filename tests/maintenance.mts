import assert from "node:assert/strict";
import {randomBytes,randomUUID,createHash} from "node:crypto";
import {mkdir,writeFile} from "node:fs/promises";
import path from "node:path";
import {execFileSync} from "node:child_process";
import {PrismaClient} from "@prisma/client";
import {unseal} from "../src/lib/staff-security";
const root=path.resolve("tests/.runtime");await mkdir(root,{recursive:true});const database=path.join(root,`maintenance-${randomUUID()}.db`);await writeFile(database,Buffer.alloc(0),{flag:"wx"});process.env.CRM_DATA_ENCRYPTION_KEY=randomBytes(32).toString("hex");const env={...process.env,DATABASE_URL:`file:${database.replaceAll("\\","/")}`,APP_ORIGIN:"http://127.0.0.1:3217"};execFileSync(process.execPath,["node_modules/prisma/build/index.js","migrate","deploy"],{env,stdio:"pipe"});const db=new PrismaClient({datasources:{db:{url:env.DATABASE_URL}}});
try{const branch=await db.branch.create({data:{code:"FIXTURE",name:"Fixture",city:"Test"}});const role=await db.role.create({data:{key:"OWNER",name:"Owner",desc:"Fixture"}});const user=await db.user.create({data:{name:"Fixture owner",email:"maintenance@example.test",phone:"",employeeCode:"FIXTURE",roleId:role.id,branchId:branch.id,passwordHash:"fixture-not-a-login-hash",bankAccount:"00112233"}});const customer=await db.customer.create({data:{code:"FIXTURE",name:"Fixture customer",phone:"+919876543210",city:"Test",branchId:branch.id}});const traveller=await db.traveller.create({data:{customerId:customer.id,fullName:"Fixture traveller",passportNumber:"P1234567"}});await db.document.create({data:{docNo:"FIXTURE",customerId:customer.id,docType:"Passport",extracted:'{"passportNumber":"P1234567"}'}});
execFileSync(process.execPath,["scripts/encrypt-sensitive.mjs","--apply"],{env,stdio:"pipe"});const encrypted=await db.traveller.findUniqueOrThrow({where:{id:traveller.id}});assert(encrypted.passportNumber?.startsWith("enc:v1."));assert.equal(unseal(encrypted.passportNumber.slice(4),"crm-field:passportNumber"),"P1234567");assert(encrypted.passportLookup);assert((await db.user.findUniqueOrThrow({where:{id:user.id}})).bankAccount?.startsWith("enc:v1."));execFileSync(process.execPath,["scripts/encrypt-sensitive.mjs","--apply"],{env,stdio:"pipe"});assert.equal((await db.traveller.findUniqueOrThrow({where:{id:traveller.id}})).passportNumber,encrypted.passportNumber,"Backfill must preserve already encrypted bytes");
const output=execFileSync(process.execPath,["scripts/staff-recovery.mjs",user.email],{env,encoding:"utf8"});const token=output.match(/\/recover#([a-f0-9]{64})/)?.[1];assert(token);const recovery=await db.staffRecovery.findUnique({where:{tokenHash:createHash("sha256").update(token).digest("hex")}});assert(recovery&&!recovery.usedAt&&recovery.expiresAt.getTime()>Date.now());console.log("Native maintenance: fresh migrations, encrypted backfill/retry and hashed expiring recovery links passed.");}finally{await db.$disconnect();}
