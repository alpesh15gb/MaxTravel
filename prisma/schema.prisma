// Travel Agency Operating System — data model
// SQLite for dev (swap datasource to postgres for production; all types are portable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Append-only reporting journal. Existing records enter as an explicit cutover opening.
// Positive customer amounts are charges/refunds; positive supplier amounts are payables.
model FinancialEntry {
  id          String    @id @default(cuid())
  partyType   String
  partyId     String
  sourceType  String
  sourceId    String
  revision    Int
  amountMinor BigInt
  reference   String
  description String
  dueDate     DateTime?
  effectiveAt DateTime  @default(now())
  recordedAt  DateTime  @default(now())
  actorId     String?
  opening     Boolean   @default(false)

  @@unique([sourceType, sourceId, revision])
  @@index([partyType, partyId, effectiveAt])
  @@index([sourceType, sourceId])
}

// ── Org ──────────────────────────────────────────────────────────────────────

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  city      String
  users     User[]
  customers Customer[]
  visaCases VisaCase[]
  bookings  Booking[]
  tasks     Task[]
}

// Role keys used by the permission matrix (lib/rbac.ts)
model Role {
  id    String @id @default(cuid())
  key   String @unique // SUPER_ADMIN, OWNER, BRANCH_MANAGER, VISA_MANAGER, ...
  name  String
  desc  String
  users User[]
}

model User {
  staffChatMemberships StaffChatMember[]
  staffChatMessages    StaffChatMessage[]
  id                   String               @id @default(cuid())
  employeeCode         String               @unique
  name                 String
  email                String               @unique
  phone                String
  passwordHash         String
  roleId               String
  role                 Role                 @relation(fields: [roleId], references: [id])
  branchId             String?
  branch               Branch?              @relation(fields: [branchId], references: [id])
  active               Boolean              @default(true)
  // HR / sensitive fields — viewable only with hr:view permission
  salary               Float?
  bankAccount          String?
  joinedOn             DateTime?
  createdAt            DateTime             @default(now())
  // Workload (overloaded-employee alert)
  tasks                Task[]               @relation("TaskOwner")
  visaCases            VisaCase[]           @relation("VisaCaseOwner")
  bookings             Booking[]            @relation("BookingOwner")
  supplierSettlements  SupplierSettlement[] @relation("SupplierSettlementRecorder")
  supplierReversals    SupplierSettlement[] @relation("SupplierSettlementReverser")
  documentsVerified    Document[]           @relation("Verifier")
  notes                Note[]
  activity             Activity[]
  notifications        Notification[]
  docAccessLogs        DocumentAccessLog[]
  taskComments         TaskComment[]
  caseStatusUpdates    VisaCaseStatus[]
  managedCustomers     Customer[]
  serviceCases         ServiceCase[]
  auditLogs            AuditLog[]
  invoiceCreditNotes   InvoiceCreditNote[]  @relation("InvoiceCreditNoteIssuer")
}

// One permanent request identity from first contact through service and aftercare.
model ServiceCase {
  staffChatThread StaffChatThread?
  legacyReference String?
  legacyStage     String?
  importSource    String?
  importedAt      DateTime?
  createdById     String?
  id              String                @id @default(cuid())
  caseNo          String                @unique
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId        String
  ownerId         String
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  service         String
  title           String
  status          String                @default("OPEN")
  nextFollowUpAt  DateTime?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bookings        Booking[]
  visaCases       VisaCase[]
  leads           SalesLead[]
  events          ServiceCaseEvent[]
  mutations       ServiceCaseMutation[]
  serviceWork     ServiceWork[]
  tasks           Task[]

  @@index([branchId, ownerId, status])
  @@index([customerId, createdAt])
  @@index([nextFollowUpAt])
}

// Import staging is encrypted; identities make subsequent exports safe to replay.
model DataImportBatch {
  id          String    @id
  actorId     String
  requestKey  String
  branchId    String
  source      String
  status      String
  inputHash   String
  planHash    String
  payload     String
  preview     String
  result      String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  committedAt DateTime?

  @@unique([actorId, requestKey])
  @@index([status, expiresAt])
}

model DataImportIdentity {
  source     String
  entity     String
  externalId String
  recordId   String
  batchId    String
  rowHash    String
  linked     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([source, entity, externalId])
  @@index([batchId])
  @@index([entity, recordId])
}

model ServiceCaseEvent {
  id          String      @id @default(cuid())
  caseId      String
  serviceCase ServiceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actorId     String?
  kind        String
  summary     String
  permission  String?
  href        String?
  at          DateTime    @default(now())

  @@index([caseId, at])
}

model ServiceCaseMutation {
  actorId     String
  requestKey  String
  bodyHash    String
  caseId      String
  serviceCase ServiceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@id([actorId, requestKey])
}

// ── Customers & Travellers ──────────────────────────────────────────────────

model Customer {
  emailOutbox     ClientEmail[]
  collections     PaymentCollection[]
  agencyMutations AgencyMutation[]
  profileData     String?
  masterMutations MasterMutation[]
  mergedIntoId    String?
  gstNumber       String?
  id              String                 @id @default(cuid())
  code            String                 @unique // C-1001
  name            String
  type            String                 @default("INDIVIDUAL") // INDIVIDUAL | CORPORATE | SUB_AGENT
  phone           String
  email           String?
  city            String
  address         String?
  status          String                 @default("ACTIVE") // ACTIVE | LEAD | INACTIVE
  companyName     String?
  subAgentOfId    String?
  branchId        String
  branch          Branch                 @relation(fields: [branchId], references: [id])
  assignedToId    String? // relationship manager
  assignedTo      User?                  @relation(fields: [assignedToId], references: [id])
  createdAt       DateTime               @default(now())
  serviceCases    ServiceCase[]
  travellers      Traveller[]
  visaCases       VisaCase[]
  bookings        Booking[]
  documents       Document[]
  payments        Payment[]
  invoices        Invoice[]
  refunds         Refund[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]
  privatePdfs     PrivatePdfAttachment[]
  uploadLinks     UploadLink[]

  @@index([name, phone])
}

model Traveller {
  profileData          String?
  loyaltyMemberships   TravellerLoyaltyMembership[]
  identityDocuments    TravellerIdentityDocument[]
  passportLookup       String?
  id                   String                       @id @default(cuid())
  customerId           String
  customer             Customer                     @relation(fields: [customerId], references: [id])
  fullName             String
  relation             String                       @default("SELF") // SELF | SPOUSE | SON | DAUGHTER | FATHER | MOTHER | EMPLOYEE | GROUP
  dateOfBirth          DateTime?
  gender               String?
  nationality          String                       @default("India")
  passportNumber       String? // sensitive — masked unless canViewSensitiveDocs
  passportIssueDate    DateTime?
  passportExpiry       DateTime?
  passportPlace        String?
  knownTravellerNumber String?
  frequentFlyer        String?
  primary              Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  documents            Document[]
  uploadLinks          UploadLink[]
  caseTravellers       CaseTraveller[]
  bookingTravellers    BookingTraveller[]

  @@index([customerId])
  @@index([passportLookup])
}

// ── Visa ─────────────────────────────────────────────────────────────────────

model VisaStage {
  id      String           @id @default(cuid())
  key     String           @unique // ENQUIRY, ASSESSMENT...
  name    String
  seq     Int              @default(0) // ordering
  system  Boolean          @default(false) // system stage cannot be deleted
  active  Boolean          @default(true)
  cases   VisaCase[]
  history VisaCaseStatus[]
}

// Admin-configurable workflow; default seed = the 16-stage spec flow.
model VisaCase {
  emailOutbox          ClientEmail[]
  supplierCost         Float?
  travelEndDate        DateTime?
  collections          PaymentCollection[]
  serviceCaseId        String?
  serviceCase          ServiceCase?        @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  id                   String              @id @default(cuid())
  caseNo               String              @unique // VC-2001
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id])
  stageId              String
  stage                VisaStage           @relation(fields: [stageId], references: [id])
  visaType             String // Tourist / Business / Student / Transit / Work
  visaCategory         String? // e.g. Visitor Visa, Salaried, Self-Employed
  destination          String
  travelDate           DateTime?
  intendedStay         String?
  applicationDate      DateTime?
  submissionDate       DateTime?
  appointmentDate      DateTime?
  biometricsDate       DateTime?
  expectedDecisionDate DateTime?
  decisionDate         DateTime?
  visaOutcome          String? // APPROVED | REJECTED
  visaValidityUntil    DateTime?
  visaFee              Float               @default(0)
  serviceFee           Float               @default(0)
  sellingPrice         Float               @default(0)
  paymentDueDate       DateTime?
  amountReceived       Float               @default(0)
  supplierId           String?
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  owner                User                @relation("VisaCaseOwner", fields: [ownerId], references: [id])
  ownerId              String
  branchId             String
  branch               Branch              @relation(fields: [branchId], references: [id])
  internalNotes        String?
  closedAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  travellers           CaseTraveller[]
  documents            Document[]
  checklistLinks       ChecklistLink[]
  history              VisaCaseStatus[]
  tasks                Task[]
  payments             Payment[]
  invoices             Invoice[]
  uploadLinks          UploadLink[]
  supplierDues         SupplierDue[]

  @@index([serviceCaseId])
  @@index([customerId])
  @@index([stageId])
}

model CaseTraveller {
  id            String    @id @default(cuid())
  caseId        String
  visaCase      VisaCase  @relation(fields: [caseId], references: [id])
  travellerId   String
  traveller     Traveller @relation(fields: [travellerId], references: [id])
  applicantType String    @default("SALARIED") // applicant type for checklist

  @@unique([caseId, travellerId])
}

model VisaCaseStatus {
  id      String    @id @default(cuid())
  caseId  String
  case    VisaCase  @relation(fields: [caseId], references: [id])
  stageId String
  stage   VisaStage @relation(fields: [stageId], references: [id])
  note    String?
  byId    String?
  by      User?     @relation(fields: [byId], references: [id])
  at      DateTime  @default(now())

  @@index([caseId])
}

// Checklist master: Country → Visa Type → Applicant Type → Version
model Checklist {
  id            String          @id @default(cuid())
  country       String
  visaType      String
  applicantType String // SALARIED | SELF_EMPLOYED | STUDENT | MINOR | RETIRED ...
  version       Int             @default(1)
  active        Boolean         @default(true)
  notes         String?
  items         ChecklistItem[]
  links         ChecklistLink[]

  @@unique([country, visaType, applicantType, version])
}

model ChecklistItem {
  id                String    @id @default(cuid())
  checklistId       String
  checklist         Checklist @relation(fields: [checklistId], references: [id])
  name              String // Passport, Photo, Bank Statement...
  required          Boolean   @default(true)
  instructions      String?
  fileTypes         String    @default("pdf,jpg,png") // csv
  maxSizeMb         Int       @default(10)
  needsExpiry       Boolean   @default(false)
  needsVerification Boolean   @default(true)
  travellerType     String    @default("ALL") // ALL | ADULT | MINOR
  sortOrder         Int       @default(0)

  @@index([checklistId])
}

// Links a checklist to a case (copied at creation; items tracked per document)
model ChecklistLink {
  id          String    @id @default(cuid())
  caseId      String
  visaCase    VisaCase  @relation(fields: [caseId], references: [id])
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  travellerId String? // when per-traveller checklist

  @@index([caseId])
}

// ── Documents ───────────────────────────────────────────────────────────────

model Document {
  aadhaarMasked Boolean @default(false)
  identityRecords        TravellerIdentityDocument[]
  sensitive              Boolean                     @default(false)
  id                     String                      @id @default(cuid())
  docNo                  String                      @unique
  customerId             String
  customer               Customer                    @relation(fields: [customerId], references: [id])
  travellerId            String?
  traveller              Traveller?                  @relation(fields: [travellerId], references: [id])
  visaCaseId             String?
  visaCase               VisaCase?                   @relation(fields: [visaCaseId], references: [id])
  checklistItemId        String?
  docType                String // Passport, Photo, Bank Statement...
  status                 String                      @default("REQUIRED")
  // REQUIRED REQUESTED RECEIVED UNDER_REVIEW ACCEPTED REJECTED REUPLOAD_REQUESTED SUBMITTED ARCHIVED
  fileName               String?
  storagePath            String? // private uploads dir; served via signed URL
  mimeType               String?
  sizeBytes              Int?
  version                Int                         @default(1)
  uploadedById           String?
  uploadSource           String? // PORTAL | STAFF | IMPORTED | EMAIL
  uploadedAt             DateTime?
  verificationStatus     String                      @default("PENDING") // PENDING VERIFIED REJECTED
  verifiedById           String?
  verifiedBy             User?                       @relation("Verifier", fields: [verifiedById], references: [id])
  verifiedAt             DateTime?
  expiryDate             DateTime?
  rejectionReason        String?
  notes                  String?
  // Document intelligence (AI suggestions — never auto-applied)
  extracted              String? // JSON { fullName, passportNumber, ... }
  extractedConfirmedById String?
  extractedConfirmedAt   DateTime?
  warnings               String? // JSON [ {type, message} ]
  createdAt              DateTime                    @default(now())
  accessLogs             DocumentAccessLog[]

  @@index([customerId])
  @@index([visaCaseId])
}
model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // VIEW | DOWNLOAD | EDIT | DELETE | SIGN_URL_ISSUED
  detail     String?
  at         DateTime @default(now())
  ip         String?
}

// Public upload links: /upload/[token]
model UploadLink {
  id          String     @id @default(cuid())
  token       String     @unique
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id])
  visaCaseId  String?
  visaCase    VisaCase?  @relation(fields: [visaCaseId], references: [id])
  travellerId String?
  traveller   Traveller? @relation(fields: [travellerId], references: [id])
  note        String?
  expiresAt   DateTime
  usedAt      DateTime?
  revoked     Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// ── Ticketing ───────────────────────────────────────────────────────────────

model Booking {
  passportValidityMonths Int @default(0)
  requirementsNote String?
  airlineChangeFee           Float               @default(0)
  noShowFee                  Float               @default(0)
  emailOutbox                ClientEmail[]
  collections                PaymentCollection[]
  serviceDescription         String?
  travelScope                String              @default("UNSPECIFIED")
  travelEndDate              DateTime?
  supplierCostConfirmed      Boolean             @default(false)
  artifacts                  BookingArtifact[]
  deliveries                 ClientDelivery[]
  serviceCaseId              String?
  serviceCase                ServiceCase?        @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  product                    String              @default("FLIGHT")
  hotelName                  String?
  hotelCheckIn               DateTime?
  hotelCheckOut              DateTime?
  id                         String              @id @default(cuid())
  bookingNo                  String              @unique // BK-3001
  customerId                 String
  customer                   Customer            @relation(fields: [customerId], references: [id])
  pnr                        String?
  airline                    String?
  gdsSource                  String? // Amadeus / Sabre / Galileo
  supplierId                 String?
  supplier                   Supplier?           @relation(fields: [supplierId], references: [id])
  status                     String              @default("ENQUIRY")
  // ENQUIRY QUOTE_SENT PNR_CREATED ON_HOLD PAYMENT_AWAITED TICKETED CANCELLED VOID
  // REISSUE_REQUESTED REISSUED REFUND_REQUESTED REFUND_PENDING REFUNDED
  sector                     String? // DEL → BOM → LHR
  flightNo                   String?
  travelDate                 DateTime?
  bookingDate                DateTime            @default(now())
  ticketingDeadline          DateTime? // drives PNR expiry alerts
  fare                       Float               @default(0)
  taxes                      Float               @default(0)
  markup                     Float               @default(0)
  serviceFee                 Float               @default(0)
  sellingPrice               Float               @default(0)
  paymentDueDate             DateTime?
  cancellationSupplierCharge Float?
  cancellationAgencyFee      Float?
  cancellationReason         String?
  cancelledAt                DateTime?
  supplierCost               Float               @default(0)
  currency                   String              @default("INR")
  owner                      User                @relation("BookingOwner", fields: [ownerId], references: [id])
  ownerId                    String
  branchId                   String
  branch                     Branch              @relation(fields: [branchId], references: [id])
  refundId                   String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  travellers                 BookingTraveller[]
  tickets                    Ticket[]
  payments                   Payment[]
  refunds                    Refund[]
  tasks                      Task[]
  reissueOfId                String?
  reissueOf                  Booking?            @relation("ReissueParent", fields: [reissueOfId], references: [id])
  reissueChildren            Booking[]           @relation("ReissueParent")
  reissueChain               Reissue[]           @relation("OriginalBooking")
  reissuesIssued             Reissue[]           @relation("ReissueBooking")
  Invoice                    Invoice[]
  supplierDues               SupplierDue[]

  @@index([serviceCaseId])
  @@index([customerId])
  @@index([pnr])
  @@index([ticketingDeadline])
}

model BookingTraveller {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  loyaltyMembershipId String?
  loyaltyProgram String?
  loyaltyNumberHint String?
  travellerId String
  traveller   Traveller @relation(fields: [travellerId], references: [id])

  @@unique([bookingId, travellerId])
}

model Ticket {
  artifacts    BookingArtifact[]
  id           String            @id @default(cuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id])
  ticketNo     String
  passenger    String
  travellerId  String?
  issueDate    DateTime?
  issuedBy     String?
  originalFare Float             @default(0)
  status       String            @default("OK") // OK | VOID | REFUNDED | REISSUED
  reissues     Reissue[]

  @@index([bookingId])
}

// Reissue chain: original ticket → reissue
model Reissue {
  taxDifference     Float     @default(0)
  airlineFee        Float     @default(0)
  noShowFee         Float     @default(0)
  agencyFee         Float     @default(0)
  quoteReference    String?
  quoteExpiresAt    DateTime?
  id                String    @id @default(cuid())
  originalTicketId  String
  originalTicket    Ticket    @relation(fields: [originalTicketId], references: [id])
  originalBookingId String
  originalBooking   Booking   @relation("OriginalBooking", fields: [originalBookingId], references: [id])
  reissuedBookingId String? // new booking created for reissued itinerary
  reissuedBooking   Booking?  @relation("ReissueBooking", fields: [reissuedBookingId], references: [id])
  reason            String
  fareDifference    Float     @default(0)
  penalty           Float     @default(0)
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  status            String    @default("REQUESTED") // REQUESTED IN_PROGRESS DONE REJECTED
  createdAt         DateTime  @default(now())
}

// ── Money ────────────────────────────────────────────────────────────────────

model Payment {
  id           String    @id @default(cuid())
  receiptNo    String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  visaCaseId   String?
  visaCase     VisaCase? @relation(fields: [visaCaseId], references: [id])
  invoiceId    String?
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id])
  amount       Float
  mode         String    @default("UPI") // CASH UPI NEFT CARD CHEQUE
  receivedOn   DateTime  @default(now())
  receivedById String?
  note         String?
  createdAt    DateTime  @default(now())
}

model Invoice {
  collections  PaymentCollection[]
  id           String              @id @default(cuid())
  invoiceNo    String              @unique // INV-4001
  documentKind String              @default("OPERATIONAL") // OPERATIONAL | TAX_INVOICE
  taxSnapshot  String?
  customerId   String
  customer     Customer            @relation(fields: [customerId], references: [id])
  visaCaseId   String?
  visaCase     VisaCase?           @relation(fields: [visaCaseId], references: [id])
  bookingId    String?
  booking      Booking?            @relation(fields: [bookingId], references: [id])
  description  String?
  amount       Float
  amountPaid   Float               @default(0)
  status       String              @default("UNPAID") // UNPAID PARTIAL PAID
  issuedOn     DateTime            @default(now())
  dueDate      DateTime?
  payments     Payment[]
  refunds      Refund[]
  creditNote   InvoiceCreditNote?

  @@index([customerId])
}

model InvoiceCreditNote {
  id           String   @id @default(cuid())
  creditNoteNo String   @unique
  invoiceId    String   @unique
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reason       String
  amount       Float
  taxSnapshot  String?
  issuedById   String?
  issuedBy     User?    @relation("InvoiceCreditNoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedOn     DateTime @default(now())
}

model Supplier {
  id             String        @id @default(cuid())
  name           String        @unique
  type           String        @default("VISA_PROCESSOR") // AIRLINE HOTEL BOOKING_PLATFORM VISA_PROCESSOR CONSOLIDATOR CONSULTANT OTHER
  contact        String?
  phone          String?
  city           String?
  paymentDueDays Int           @default(15)
  visaCases      VisaCase[]
  bookings       Booking[]
  reissues       Reissue[]
  dues           SupplierDue[]
}

model SupplierDue {
  id                String               @id @default(cuid())
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  bookingId         String?
  booking           Booking?             @relation(fields: [bookingId], references: [id])
  visaCaseId        String?
  visaCase          VisaCase?            @relation(fields: [visaCaseId], references: [id], onDelete: Restrict)
  description       String
  supplierInvoiceNo String?
  amount            Float
  paidAmount        Float                @default(0)
  dueDate           DateTime
  paid              Boolean              @default(false)
  paidOn            DateTime?
  createdAt         DateTime             @default(now())
  settlements       SupplierSettlement[]

  @@index([supplierId, dueDate])
  @@index([bookingId])
  @@index([visaCaseId])
}

model SupplierSettlement {
  id             String      @id @default(cuid())
  dueId          String
  due            SupplierDue @relation(fields: [dueId], references: [id], onDelete: Restrict)
  amount         Float
  method         String      @default("OTHER") // CASH UPI NEFT CARD CHEQUE BANK_TRANSFER OTHER MIGRATED
  reference      String?
  note           String?
  settledOn      DateTime    @default(now())
  recordedById   String?
  recordedBy     User?       @relation("SupplierSettlementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  requestKey     String      @unique
  reversedOn     DateTime?
  reversedById   String?
  reversedBy     User?       @relation("SupplierSettlementReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalReason String?
  createdAt      DateTime    @default(now())

  @@index([dueId, settledOn])
}

model Refund {
  id                 String    @id @default(cuid())
  refundNo           String    @unique // RF-5001
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  bookingId          String?
  booking            Booking?  @relation(fields: [bookingId], references: [id])
  invoiceId          String?
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id])
  amount             Float
  reason             String?
  status             String    @default("REQUESTED")
  // REQUESTED SUPPLIER_PENDING SUPPLIER_RECEIVED APPROVED PROCESSED PAID REJECTED
  requestedOn        DateTime  @default(now())
  supplierSentOn     DateTime?
  supplierReceivedOn DateTime?
  paidOn             DateTime?
  approvedById       String?
  processedById      String?
  createdAt          DateTime  @default(now())
}

// ── Work & communication ─────────────────────────────────────────────────────

model Task {
  id              String        @id @default(cuid())
  title           String
  details         String?
  status          String        @default("OPEN") // OPEN IN_PROGRESS DONE CANCELLED
  priority        String        @default("MEDIUM") // LOW MEDIUM HIGH URGENT
  dueAt           DateTime?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  ownerId         String
  owner           User          @relation("TaskOwner", fields: [ownerId], references: [id])
  creatorId       String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  visaCaseId      String?
  visaCase        VisaCase?     @relation(fields: [visaCaseId], references: [id])
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  serviceCaseId   String?
  serviceCase     ServiceCase?  @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  serviceWorkId   String?
  serviceWork     ServiceWork?  @relation(fields: [serviceWorkId], references: [id], onDelete: Restrict)
  workState       String        @default("TODO")
  unassigned      Boolean       @default(false)
  originalDueAt   DateTime?
  waitingReason   String?
  nextCheckAt     DateTime?
  outcome         String?
  requiresReview  Boolean       @default(false)
  resultType      String        @default("NOTE")
  required        Boolean       @default(true)
  hardDeadline    Boolean       @default(false)
  reviewerId      String?
  startedAt       DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  assignedAt      DateTime?
  updatedAt       DateTime      @default(now())
  version         Int           @default(1)
  workflowTracked Boolean       @default(false)
  sourceKey       String?       @unique
  prerequisiteId  String?
  prerequisite    Task?         @relation("TaskPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)
  dependents      Task[]        @relation("TaskPrerequisite")
  waived          Boolean       @default(false)
  events          WorkEvent[]
  comments        TaskComment[]

  @@index([ownerId, status])
  @@index([serviceCaseId, status])
  @@index([branchId, workState, dueAt])
  @@index([reviewerId, workState])
}

model ServiceWork {
  id              String      @id @default(cuid())
  caseId          String
  serviceCase     ServiceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  service         String
  title           String
  templateVersion Int?
  createdAt       DateTime    @default(now())
  tasks           Task[]

  @@unique([caseId, service])
}

model WorkEvent {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorId       String?
  actorName     String
  taskTitle     String    @default("")
  caseNo        String?
  kind          String
  fromState     String?
  toState       String
  assigneeId    String?
  assigneeName  String?
  dueAt         DateTime?
  originalDueAt DateTime?
  detail        String
  at            DateTime  @default(now())

  @@index([taskId, at])
  @@index([kind, at])
  @@index([assigneeId, at])
}

model WorkMutation {
  actorId    String
  requestKey String
  bodyHash   String
  response   String
  createdAt  DateTime @default(now())

  @@id([actorId, requestKey])
}

model TaskComment {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id])
  userId String?
  user   User?    @relation(fields: [userId], references: [id])
  body   String
  at     DateTime @default(now())
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model PrivatePdfAttachment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  filename   String
  storageKey String   @unique
  sha256     String
  size       Int
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String?
  link      String?
  severity  String   @default("INFO") // INFO WARNING URGENT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Activity {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id])
  type       String // NOTE | STATUS | PAYMENT | MESSAGE | DOC ...
  summary    String
  link       String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  action   String
  entity   String
  entityId String?
  detail   String?
  at       DateTime @default(now())
}

model PlatformEvent {
  id          String   @id
  bodyHash    String
  aggregateId String
  receivedAt  DateTime @default(now())
}

model PlatformCommand {
  id         String   @id
  bookingId  String
  actorId    String
  request    String
  state      String   @default("STARTED")
  response   String?
  httpStatus Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bookingId, createdAt])
}

model PlatformCustomerLink {
  platformId String @id
  customerId String @unique
}

model PlatformBookingLink {
  platformId        String   @id
  bookingId         String   @unique
  revision          Int
  supplierReference String?
  platformStatus    String?
  documentsCurrent  Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model StaffSession {
  id        String    @id
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  agent     String

  @@index([userId, expiresAt])
}

model StaffMfa {
  userId         String   @id
  secret         String
  enabled        Boolean  @default(false)
  lastStep       Int      @default(-1)
  recoveryHashes String   @default("[]")
  updatedAt      DateTime @updatedAt
}

model StaffRecovery {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model SalesLead {
  serviceCaseId String?
  serviceCase   ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  id            String       @id @default(cuid())
  customerId    String
  branchId      String
  ownerId       String
  title         String
  source        String
  product       String       @default("FLIGHT")
  stage         String       @default("NEW")
  budgetMinor   Int          @default(0)
  destination   String?
  travelDate    DateTime?
  followUpAt    DateTime?
  lostReason    String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quotes        SalesQuote[]

  @@index([serviceCaseId])
  @@index([branchId, ownerId, stage])
  @@index([customerId])
}

model SalesQuote {
  id           String    @id @default(cuid())
  leadId       String
  lead         SalesLead @relation(fields: [leadId], references: [id])
  version      Int
  items        String
  terms        String
  totalMinor   Int
  costMinor    Int
  expiresAt    DateTime
  state        String    @default("DRAFT")
  shareHash    String?   @unique
  acceptedName String?
  acceptedAt   DateTime?
  bookingId    String?   @unique
  createdBy    String
  createdAt    DateTime  @default(now())

  @@unique([leadId, version])
}

model StaffAuthFailure {
  id      String   @id @default(cuid())
  keyHash String
  at      DateTime @default(now())

  @@index([keyHash, at])
}

// Durable, actor-scoped financial-create replay protection. No raw request body is retained.
model FinancialMutation {
  id           String   @id @default(cuid())
  actorId      String
  operation    String
  requestKey   String
  requestHash  String
  responseJson String
  createdAt    DateTime @default(now())

  @@unique([actorId, operation, requestKey])
}

// Agency-wide marketing catalogue. Drafts never implicitly replace public content.
model TravelPackage {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  status        String         @default("DRAFT")
  draftJson     String
  publishedJson String?
  revision      Int            @default(1)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  media         PackageMedia[]

  @@index([status, publishedAt])
}

// Immutable marketing images, isolated from private customer documents.
model PackageMedia {
  id          String        @id
  packageId   String
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  storageName String        @unique
  mimeType    String
  byteSize    Int
  width       Int
  height      Int
  sha256      String
  createdAt   DateTime      @default(now())

  @@index([packageId, createdAt])
}

model TravellerLoyaltyMembership {
  id           String    @id @default(cuid())
  travellerId  String
  traveller    Traveller @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  category     String
  providerName String
  programName  String
  programKey   String
  carrierCodes String    @default("[]")
  memberNumber String
  numberLookup String
  memberName   String?
  tier         String?
  expiryDate   String?
  preferred    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([travellerId, programKey, numberLookup], map: "traveller_loyalty_program_number_key")
  @@index([travellerId, category])
  @@index([expiryDate])
}

model TravellerIdentityDocument {
  id              String    @id @default(cuid())
  travellerId     String
  traveller       Traveller @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  kind            String
  documentNumber  String
  numberLookup    String
  issuingCountry  String
  nationality     String?
  issueDate       String?
  expiryDate      String?
  placeOfIssue    String?
  validFrom       String?
  validFor        String?
  maximumStayDays String?
  visaType        String?
  entries         String?
  primaryPassport Boolean   @default(false)
  fileDocumentId  String?
  fileDocument    Document? @relation(fields: [fileDocumentId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([travellerId, kind, issuingCountry, numberLookup], map: "traveller_identity_number_key")
  @@index([travellerId])
  @@index([expiryDate])
}

model MasterMutation {
  actorId    String
  requestKey String
  bodyHash   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  result     String
  createdAt  DateTime @default(now())

  @@id([actorId, requestKey])
  @@index([customerId])
}

// Internal staff conversations. Customer-facing delivery uses a different capability boundary.
model StaffChatThread {
  nextSequence Int                @default(0)
  id           String             @id @default(cuid())
  key          String             @unique
  kind         String
  caseId       String?            @unique
  serviceCase  ServiceCase?       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      StaffChatMember[]
  messages     StaffChatMessage[]
}

model StaffChatMember {
  unreadCount      Int             @default(0)
  id               String          @id @default(cuid())
  threadId         String
  thread           StaffChatThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadAt       DateTime?
  lastReadSequence Int             @default(0)
  joinedAt         DateTime        @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model StaffChatMessage {
  sequence   Int
  id         String          @id @default(cuid())
  threadId   String
  thread     StaffChatThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  requestKey String
  bodyHash   String
  body       String
  createdAt  DateTime        @default(now())

  @@unique([authorId, requestKey])
  @@unique([threadId, sequence])
}

model BookingArtifact {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  ticketId     String?
  ticket       Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedById String
  requestKey   String
  bodyHash     String
  fileName     String
  storageName  String
  mimeType     String
  sizeBytes    Int
  fileHash     String
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([uploadedById, requestKey])
  @@index([bookingId])
}

model ClientDelivery {
  emails          ClientEmail[]
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdById     String
  requestKey      String
  bodyHash        String
  tokenHash       String        @unique
  tokenCipher     String
  artifactIds     String
  snapshotHash    String
  exceptionReason String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@unique([createdById, requestKey])
  @@index([bookingId])
}

model AgencyMutation {
  actorId    String
  requestKey String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bodyHash   String
  result     String
  createdAt  DateTime @default(now())

  @@id([actorId, requestKey])
  @@index([customerId])
}

model ClientEmail {
  visaCaseId   String?
  visaCase     VisaCase?          @relation(fields: [visaCaseId], references: [id], onDelete: Restrict)
  collectionId String?
  collection   PaymentCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  id           String             @id @default(cuid())
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingId    String?
  booking      Booking?           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  deliveryId   String?
  delivery     ClientDelivery?    @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  createdById  String
  requestKey   String
  bodyHash     String
  recipient    String
  subject      String
  body         String
  purpose      String
  status       String             @default("QUEUED")
  messageId    String             @unique
  attempts     Int                @default(0)
  claimedAt    DateTime?
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime           @default(now())

  @@unique([createdById, requestKey])
  @@index([status, createdAt])
}

model PaymentCollection {
  emails      ClientEmail[]
  id          String        @id @default(cuid())
  provider    String
  reference   String        @unique
  providerId  String?       @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingId   String?
  booking     Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  visaCaseId  String?
  visaCase    VisaCase?     @relation(fields: [visaCaseId], references: [id], onDelete: Restrict)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountMinor Int
  currency    String        @default("INR")
  checkoutUrl String?
  activeKey   String?       @unique
  createdById String
  requestKey  String
  bodyHash    String
  status      String        @default("CREATING")
  lastError   String?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([createdById, requestKey])
  @@index([customerId])
}

model CollectionEvent {
  id           String    @id
  provider     String
  collectionId String
  paymentId    String
  bodyHash     String
  status       String    @default("QUEUED")
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
}

model CollectionSettlement {
  id           String   @id @default(cuid())
  provider     String
  paymentId    String
  collectionId String
  amountMinor  Int
  currency     String
  receiptIds   String
  status       String   @default("POSTED")
  createdAt    DateTime @default(now())

  @@unique([provider, paymentId])
}
