{
  "name": "travel-os",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .js,.mjs,.cjs,.jsx,.ts,.mts,.cts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test": "node tests/login-readiness.mjs && node --import tsx tests/customer-sales-history.mts && node --import tsx tests/sales-attention.mts && node tests/sales-handoff-controller.mjs && tsx tests/workflow-regressions.ts && node tests/backup-restore.mjs && node --import tsx tests/export-format.ts && node --import tsx tests/export-routes.ts && tsx tests/reporting-workspace.ts && tsx tests/report-read.ts && node --test tests/reporting-diagnostics.test.mjs && tsx tests/reporting.ts && tsx tests/whatsapp-format.ts && tsx tests/whatsapp-composer-memory.ts && npm run test:meta-inbound && node tests/smoke.mjs && node tests/evolution.mjs && node tests/a11y-gate.mjs && node tests/ui-metrics.mjs",
    "test:crm-core": "tsx tests/staff-security.ts && tsx tests/sensitive-encryption.ts && tsx tests/customer-import.ts && tsx tests/upload-scan.mts && node --import ./scripts/standalone-server.mjs --import tsx tests/incoming-media.mts && node --import tsx tests/maintenance.mts",
    "test:staff-sales": "node --import tsx tests/staff-sales-flow.mts",
    "test:journeys": "node tests/journey-suite.mjs",
    "test:cases": "node --import tsx tests/service-case-migration.mts && node tests/service-cases-browser.mjs",
    "test:workspace-revamp": "node --import tsx tests/workspace-guide.ts && node tests/workspace-revamp-browser.mjs",
    "test:reporting": "node --import tsx tests/export-format.ts && node --import tsx tests/export-routes.ts && tsx tests/reporting-workspace.ts && tsx tests/report-read.ts && node --test tests/reporting-diagnostics.test.mjs && tsx tests/reporting.ts",
    "reports:reconcile": "node scripts/reconcile-reporting.mjs",
    "test:evolution": "node tests/evolution.mjs",
    "test:a11y": "node tests/a11y-gate.mjs",
    "test:ui": "node tests/ui-metrics.mjs",
    "a11y:budget": "node tests/a11y-gate.mjs --update-budget",
    "test:travel-packages": "node --import ./scripts/standalone-server.mjs --import tsx tests/travel-packages.mts",
    "test:travel-packages-browser": "node --import tsx tests/travel-packages-browser.mts",
    "test:travel-packages-http": "node --import tsx tests/travel-packages-browser.mts --http-only",
    "test:package-media": "node --import ./scripts/standalone-server.mjs --import tsx tests/package-media.mts",
    "test:two-app-packages": "node --import tsx tests/two-app-packages.mts",
    "test:whatsapp-composer": "tsx tests/whatsapp-composer-memory.ts",
    "test:whatsapp-browser": "node --import tsx tests/whatsapp-recipient-context-browser.mts",
    "test:whatsapp-idempotency": "node --import tsx tests/whatsapp-manual-idempotency.mts",
    "test:meta-inbound": "node --import ./scripts/standalone-server.mjs --import tsx tests/meta-inbound.mts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.2",
    "next": "16.4.1",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.29",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "playwright": "1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
