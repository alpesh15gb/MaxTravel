# Copy to .env and fill in real values. Never commit .env (it is git-ignored).

# SQLite for one server. PostgreSQL/MySQL require a schema and migration project;
# changing this URL alone does not switch the database provider.
DATABASE_URL="file:./dev.db"

# Signs staff session cookies. Generate your own, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out — useful if a device is lost.
JWT_SECRET=""

# The address staff actually reach the workspace on, e.g. https://office.example.com
# A bare origin (scheme and host only, no path). Cross-site write protection compares a request's
# Origin header with this, so set it whenever a reverse proxy sits in front of the app.
APP_ORIGIN=""

# Set to "1" only when a proxy you control terminates the connection in front of the app. It makes
# the sign-in limiter read the client address from the forwarded header rather than the address our
# own server accepted the connection from. Wrong when the app is exposed directly.
TRUST_PROXY=""

# Where private customer documents are stored. Defaults to ./uploads when unset.
# These files are never public; they are served through short-lived signed URLs.
UPLOAD_ROOT="./uploads"

# Authenticates the general CRM maintenance worker; generate separately from JWT_SECRET.
CRM_WORKER_SECRET=""

# Optional booking-platform receiver. Leave blank to keep it disabled.
# JSON object mapping sender key IDs to random shared secrets of at least 32 characters.
# Example format only: '{"booking-v1":"REPLACE_WITH_YOUR_GENERATED_SHARED_SECRET"}'
BOOKING_PLATFORM_SIGNING_KEYS=""
BOOKING_PLATFORM_OWNER_ID=""
BOOKING_PLATFORM_BRANCH_ID=""

# Separate direction-specific secret for CRM staff commands to the booking application
BOOKING_PLATFORM_API_URL=
BOOKING_PLATFORM_COMMAND_KEY=
BOOKING_PLATFORM_COMMAND_KEY_ID=
# Private AES-256-GCM key for staff authenticator secrets. Keep stable and back it up privately.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRM_DATA_ENCRYPTION_KEY=
# Optional local ClamAV service. When required, scanner errors block new file ingestion.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_REQUIRED=false
# Enable after the encryption key is configured and staff have enrolled authenticators.
CRM_REQUIRE_MFA=false
# Optional dedicated marketing-image storage; default: package-media beside the SQLite DB.
# Keep outside public/ and private UPLOAD_ROOT. Persist and back up this directory with the DB.
PACKAGE_MEDIA_ROOT=

# Optional exact HTTPS origins for protected Vercel service calls; keep [] elsewhere.
PROTECTED_API_ORIGINS=[]

# Customer email: queued server-side; TLS validation stays enabled. Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Manual CRM collections are opt-in. Current Razorpay adapter accepts test keys only.
CRM_COLLECTIONS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional comma-separated prior/current signing secrets during webhook secret rotation.
RAZORPAY_WEBHOOK_SECRETS=
# PayGlocal remains held pending its merchant-specific CRM/travel payload confirmation.
